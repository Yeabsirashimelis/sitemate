# Copy this file to .env and fill in your own values. Never commit .env.

# Google AI Studio, https://aistudio.google.com/apikey
GEMINI_API_KEY=

# From @BotFather in Telegram
TELEGRAM_BOT_TOKEN=

# Neon Postgres connection string, https://console.neon.tech
DATABASE_URL=

# Optional: Google Calendar sync. Create a calendar, share it with the service
# account email ("Make changes and see all event details") and paste its id
# from Settings > Integrate calendar. The key file stays out of Git.
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=google-service-account.json
